# ============================================================
# Railway Environment Variables Reference
# ============================================================
# Copy these into Railway → your service → Variables tab.
# DO NOT commit this file with real secrets.
# ============================================================

# --- Server binding (CRITICAL for Railway) ---
NODE_ENV=production
HOST=0.0.0.0
# PORT is injected automatically by Railway — do NOT set it here

# --- MongoDB (Railway Plugin) ---
# After adding the MongoDB plugin, Railway gives you $MONGO_URL automatically.
# Add a variable that maps it:
DATABASE_URL=${{MongoDB.MONGO_URL}}

# --- App URL (set this AFTER Railway gives you a domain) ---
NEXT_PUBLIC_APP_URL=https://YOUR-APP.railway.app
AUTH_URL=https://YOUR-APP.railway.app
NEXTAUTH_URL=https://YOUR-APP.railway.app

# --- Socket.io CORS ---
NEXT_PUBLIC_SOCKET_URL=
SOCKET_IO_CORS_ORIGIN=https://YOUR-APP.railway.app

# --- Auth secrets (generate with: openssl rand -base64 32) ---
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_STRING
NEXTAUTH_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- OAuth (optional — leave empty to hide buttons) ---
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- OpenAI (optional — for AI persona feature) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini-2026-03-17
AI_AGENT_TIME_ZONE=Africa/Cairo

# --- ZegoCloud (optional — for voice/video calls) ---
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# --- Web Push (optional — generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com
