# ============================================================
# Railway Environment Variables Template
# ============================================================
# App Domain: https://mada-chat-app-production.up.railway.app
# ============================================================

# --- Server & Environment ---
NODE_ENV=production
HOST=0.0.0.0

# --- MongoDB Database (Auto-linked via Railway Plugin) ---
DATABASE_URL=${{MongoDB.MONGO_URL}}

# --- Application URLs ---
NEXT_PUBLIC_APP_URL=https://mada-chat-app-production.up.railway.app
AUTH_URL=https://mada-chat-app-production.up.railway.app
NEXTAUTH_URL=https://mada-chat-app-production.up.railway.app

# --- Socket.io Real-Time & CORS ---
SOCKET_IO_CORS_ORIGIN=https://mada-chat-app-production.up.railway.app
SOCKET_IO_PATH=/socket.io
NEXT_PUBLIC_SOCKET_IO_PATH=/socket.io

# --- Auth Secrets ---
AUTH_SECRET=dfgfdhddgjsfhjdjhdgtjktrheui4654yu3jws54je5
NEXTAUTH_SECRET=dfgfdhddgjsfhjdjhdgtjktrheui4654yu3jws54je5

# --- ZegoCloud (Voice & Video Calls) ---
ZEGO_APP_ID=274456281
ZEGO_SERVER_SECRET=YOUR_ZEGO_SECRET_HERE

# --- OpenAI (AI Persona & Assistant) ---
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
OPENAI_CHAT_MODEL=gpt-5.4-mini-2026-03-17
AI_AGENT_TIME_ZONE=Africa/Cairo
