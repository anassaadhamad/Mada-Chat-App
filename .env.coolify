# ============================================================
# Coolify Environment Variables Template
# ============================================================
# App Domain: https://mada.anas.lol
# ============================================================

# --- Server & Environment ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# --- MongoDB Database ---
# Replace with your Coolify MongoDB internal connection string or MongoDB Atlas URI
# Example internal: mongodb://username:password@mongodb-container-name:27017/secret-chat?authSource=admin
DATABASE_URL=mongodb://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:27017/secret-chat?authSource=admin

# --- Application URLs ---
NEXT_PUBLIC_APP_URL=https://mada.anas.lol
AUTH_URL=https://mada.anas.lol
NEXTAUTH_URL=https://mada.anas.lol

# --- Socket.io Real-Time & CORS ---
SOCKET_IO_CORS_ORIGIN=https://mada.anas.lol
SOCKET_IO_PATH=/socket.io
NEXT_PUBLIC_SOCKET_IO_PATH=/socket.io

# --- Auth Secrets ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=YOUR_AUTH_SECRET_HERE
NEXTAUTH_SECRET=YOUR_AUTH_SECRET_HERE

# --- ZegoCloud (Voice & Video Calls) ---
ZEGO_APP_ID=274456281
ZEGO_SERVER_SECRET=YOUR_ZEGO_SECRET_HERE

# --- OpenAI (AI Persona & Assistant) ---
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
OPENAI_CHAT_MODEL=gpt-5.4-mini-2026-03-17
AI_AGENT_TIME_ZONE=Africa/Cairo
