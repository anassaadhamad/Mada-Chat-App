# Copy to `.env` and adjust. Values below match app defaults (see `src/lib/env-server.ts`, `src/lib/env-public.ts`).
# Use the same host in the browser as in NEXT_PUBLIC_APP_URL (127.0.0.1 vs localhost affects cookies).

# Public app URL (server-side links; use the same origin you open in the browser)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Optional: Socket.io URL when it differs from the tab origin (leave empty to use window.location.origin)
NEXT_PUBLIC_SOCKET_URL=

# MongoDB (required for register + OAuth user sync)
DATABASE_URL=mongodb://127.0.0.1:27017/secret-chat

# NextAuth / Auth.js — use a long random string in production (openssl rand -base64 32)
AUTH_SECRET=change-me-in-production
NEXTAUTH_SECRET=change-me-in-production

# Must match the origin in the address bar (same as NEXT_PUBLIC_APP_URL for local dev).
AUTH_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000

# GitHub OAuth (leave IDs empty to hide the button)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Custom HTTP server + Socket.io
PORT=3000
HOST=127.0.0.1
HTTP_SERVER_HEADERS_TIMEOUT_MS=120000

# Socket.io CORS: comma-separated origins (overrides fallback when set)
SOCKET_IO_CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
SOCKET_IO_PATH=/socket.io

# Used only when SOCKET_IO_CORS_ORIGIN and NEXT_PUBLIC_APP_URL are unset (normally overridden above)
SOCKET_IO_CORS_ORIGINS_DEFAULT=http://localhost:3000,http://127.0.0.1:3000

# Messages / pagination (server)
MESSAGE_MAX_CONTENT_LENGTH=8000
MESSAGE_REPLY_EXCERPT_MAX_LENGTH=200
MESSAGE_REPLY_EXCERPT_SCHEMA_MAX=500
MESSAGE_FILE_NAME_MAX_LENGTH=512
MESSAGE_EMOJI_MAX_LENGTH=16
MESSAGE_LIST_INITIAL_LIMIT=80
MESSAGE_LIST_OLDER_PAGE_DEFAULT=100
MESSAGE_LIST_OLDER_PAGE_MAX=200
MESSAGE_REPORT_REASON_MAX_LENGTH=2000

# AI Primary Service (OpenRouter / OpenAI-compatible; server-only)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model ID on OpenRouter (e.g. meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat, etc.)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Optional custom base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Fallback Service (Groq - ultra-fast inference & free tier available)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# IANA timezone for AI transcript [Time: …] headers and session clock (default: UTC).
# Suggested/reply AI calls use the browser's clientClock instead; this is the fallback for autopilot (no client in that path).
AI_AGENT_TIME_ZONE=UTC
# POST .../ai-agent/suggest and .../reply require JSON field clientClock: { nowEpochMs, timeZone, localLabel } from the app (see buildAiClientClockPayload).
# AI persona: transcript tail length (12–60, default 36) and completion token cap (200–2048, default 512).
AI_AGENT_HISTORY_MESSAGE_LIMIT=36
AI_AGENT_MAX_COMPLETION_TOKENS=512

# Link preview fetch
LINK_PREVIEW_MAX_REDIRECTS=5
LINK_PREVIEW_MAX_BODY_BYTES=450000
LINK_PREVIEW_FETCH_TIMEOUT_MS=12000
LINK_PREVIEW_USER_AGENT="Mozilla/5.0 (compatible; MadaLinkBot/1.0; +https://example.invalid) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
LINK_PREVIEW_OG_DESCRIPTION_MAX_LENGTH=320
LINK_PREVIEW_OG_TITLE_MAX_LENGTH=300

# Upload: max bytes for a single file (server); optional override of default + cap
UPLOAD_MAX_BYTES=1073741824
UPLOAD_DEFAULT_MAX_BYTES=1073741824
UPLOAD_MAX_BYTES_CAP=2147483648
UPLOAD_CLIENT_TIMEOUT_MS=0

# Web Push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com
WEB_PUSH_SUBJECT_DEFAULT=mailto:noreply@localhost
PUSH_SENDER_DISPLAY_MAX_LENGTH=120

# Admin API limits
ADMIN_USERS_PAGE_LIMIT_DEFAULT=20
ADMIN_USERS_PAGE_LIMIT_MAX=100
ADMIN_USERS_PAGE_LIMIT_MIN=5
ADMIN_USER_CONVERSATIONS_MAX=200
ADMIN_REPORT_MESSAGE_PREVIEW_MAX=200
ADMIN_REPORTS_LIST_DEFAULT=50
ADMIN_REPORTS_LIST_MAX=200

# Public client (exposed in the browser bundle)
NEXT_PUBLIC_SOCKET_IO_PATH=/socket.io
NEXT_PUBLIC_SOCKET_RECONNECT_DELAY_MS=1000
NEXT_PUBLIC_SOCKET_RECONNECT_DELAY_MAX_MS=8000
NEXT_PUBLIC_SOCKET_TIMEOUT_MS=20000
NEXT_PUBLIC_TWEMOJI_ASSETS_BASE=https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/
NEXT_PUBLIC_CHAT_HISTORY_FETCH_LIMIT=100
NEXT_PUBLIC_UPLOAD_MAX_BYTES=1073741824
NEXT_PUBLIC_UPLOAD_DEFAULT_MAX_BYTES=1073741824
NEXT_PUBLIC_UPLOAD_MAX_BYTES_CAP=2147483648
NEXT_PUBLIC_UPLOAD_CLIENT_TIMEOUT_MS=0
NEXT_PUBLIC_APP_LOCK_TIMEOUT_MS=300000

# ZegoCloud UIKit — 1:1 voice/video (https://console.zegocloud.com). When unset, call buttons stay hidden.
# Server secret must be 16, 24, or 32 UTF-8 bytes (typical console value is 32 characters).
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# Admin: grant in MongoDB, e.g. db.users.updateOne({ email: "you@example.com" }, { $set: { role: "ADMIN" } })
# Behind reverse proxies, raise body/timeouts for large uploads (nginx client_max_body_size, proxy_read_timeout, etc.).
